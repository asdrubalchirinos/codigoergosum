---
interface Props {
	kind?: "articulo" | "short";
	variant?: "overlay" | "inline";
}

const { kind, variant = "inline" } = Astro.props;
const show = kind === "short";
---

{
	show && variant === "overlay" && (
		<span class="kind-badge overlay" aria-label="Shorts">
			<span class="kind-badge-label">Shorts</span>
		</span>
	)
}
{
	show && variant === "inline" && (
		<span class="kind-badge inline" aria-label="Shorts">Shorts</span>
	)
}

<style>
	.kind-badge {
		font-weight: 700;
		letter-spacing: 0.5px;
		text-transform: uppercase;
		color: #fff;
		background: rgb(var(--accent));
	}

	.kind-badge.overlay {
		position: absolute;
		top: 0;
		right: 0;
		z-index: 10;
		display: block;
		width: 108px;
		height: 108px;
		overflow: hidden;
		background: none;
		pointer-events: none;
	}

	.kind-badge-label {
		position: absolute;
		top: 22px;
		right: -32px;
		width: 148px;
		padding: 5px 0;
		background: rgb(var(--accent));
		color: #fff;
		font-size: 0.7rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-align: center;
		text-transform: uppercase;
		box-shadow: 0 2px 8px rgba(0, 0, 0, 0.28);
		transform: rotate(45deg);
	}

	.kind-badge.inline {
		display: inline-flex;
		align-items: center;
		padding: 0.15em 0.55em;
		font-size: 0.7rem;
		line-height: 1.2;
		border-radius: 4px;
		vertical-align: middle;
		margin-right: 0.4em;
		position: relative;
		top: -0.15em;
	}
</style>
