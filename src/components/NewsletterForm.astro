---
interface Props {
    mode?: "compact" | "full" | "article";
    title?: string;
    description?: string;
}

const {
    mode = "full",
    title = "Suscríbete al newsletter",
    description = "Recibe las últimas publicaciones directamente en tu correo. Sin spam, solo contenido de calidad.",
} = Astro.props;
---

<div class={`newsletter-form ${mode}`}>
    <div class="content">
        <h3>{title}</h3>
        <p>{description}</p>

        <form id="newsletter-form" class="form">
            <div class="input-group">
                <input
                    type="email"
                    name="email"
                    placeholder="tu@email.com"
                    required
                    aria-label="Dirección de correo electrónico"
                />
                <button type="submit">Suscribirse</button>
            </div>
            <!-- Turnstile Widget -->
            <div
                class="cf-turnstile"
                data-sitekey={import.meta.env.PUBLIC_TURNSTILE_SITE_KEY}
                data-theme="light"
            >
            </div>
            <div class="message" aria-live="polite"></div>
        </form>
    </div>
</div>

<script
    src="https://challenges.cloudflare.com/turnstile/v0/api.js"
    async
    defer
    is:inline></script>

<script>
    const form = document.getElementById("newsletter-form") as HTMLFormElement;
    const messageEl = form?.querySelector(".message") as HTMLDivElement;
    const submitBtn = form?.querySelector(
        'button[type="submit"]',
    ) as HTMLButtonElement;

    if (form) {
        form.addEventListener("submit", async (e) => {
            e.preventDefault();
            const formData = new FormData(form);
            const email = formData.get("email");
            const token = formData.get("cf-turnstile-response");

            // Disable button and show loading state
            if (submitBtn) {
                submitBtn.disabled = true;
                submitBtn.textContent = "Enviando...";
            }
            if (messageEl) {
                messageEl.textContent = "";
                messageEl.className = "message";
            }

            try {
                const configuredApiUrl = import.meta.env
                    .PUBLIC_NEWSLETTER_API_URL;
                const API_URL =
                    configuredApiUrl ||
                    (import.meta.env.DEV ? "http://localhost:8787" : "");

                if (!API_URL) {
                    throw new Error("Newsletter API URL not configured");
                }

                const response = await fetch(
                    `${API_URL.replace(/\/$/, "")}/api/subscribe`,
                    {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/json",
                        },
                        body: JSON.stringify({ email, token }),
                    },
                );

                if (!response.ok) {
                    let errorMessage = "Error al suscribirse";
                    try {
                        const errorData = await response.json();
                        if (errorData?.error) {
                            errorMessage = errorData.error;
                        }
                    } catch {
                        // Keep generic message when response body is not JSON.
                    }
                    throw new Error(errorMessage);
                }

                if (messageEl) {
                    messageEl.textContent =
                        "¡Gracias! Revisa tu correo para confirmar tu suscripción.";
                    messageEl.classList.add("success");
                }
                form.reset();
            } catch (error) {
                console.error(error);
                if (messageEl) {
                    messageEl.textContent =
                        "Hubo un error. Por favor intenta de nuevo.";
                    messageEl.classList.add("error");
                }
            } finally {
                if (submitBtn) {
                    submitBtn.disabled = false;
                    submitBtn.textContent = "Suscribirse";
                }
            }
        });
    }
</script>

<style>
    .newsletter-form {
        background: rgb(var(--gray-light));
        padding: 2rem;
        border-radius: 8px;
        margin: 2rem 0;
    }

    .newsletter-form.compact {
        padding: 1.5rem;
    }

    .newsletter-form.article {
        margin: 2.5rem 0 0;
        padding: 2rem 1.5rem;
        background: linear-gradient(
            135deg,
            rgba(var(--accent-light), 0.35) 0%,
            rgba(var(--accent-light), 0.15) 100%
        );
        border: 1px solid rgba(var(--accent), 0.5);
        border-radius: 16px;
        box-shadow: 0 4px 14px -2px rgba(var(--gray), 0.25);
        text-align: center;
    }

    .newsletter-form.article .content h3 {
        margin-bottom: 0.75rem;
        font-size: 1.4rem;
    }

    .newsletter-form.article .content p {
        margin-bottom: 1.5rem;
        font-size: 1.1rem;
        color: rgb(var(--gray-dark));
    }

    .newsletter-form.article input[type="email"] {
        border-radius: 10px;
        padding: 0.75rem 1rem;
    }

    .newsletter-form.article button {
        border-radius: 10px;
        padding: 0.75rem 1.5rem;
        box-shadow: 0 4px 8px -2px rgba(var(--accent), 0.5);
    }

    .content h3 {
        margin-top: 0;
        margin-bottom: 0.5rem;
    }

    .content p {
        margin-bottom: 1.5rem;
        color: rgb(var(--gray));
    }

    .form {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .input-group {
        display: flex;
        gap: 0.5rem;
    }

    input[type="email"] {
        flex: 1;
        padding: 0.5rem 1rem;
        border: 1px solid rgb(var(--gray));
        border-radius: 4px;
        font-size: 1rem;
    }

    button {
        padding: 0.5rem 1.5rem;
        background-color: rgb(var(--accent));
        color: white;
        border: none;
        border-radius: 4px;
        cursor: pointer;
        font-weight: bold;
        transition: background-color 0.2s;
    }

    button:hover {
        background-color: rgb(var(--accent-dark));
    }

    button:disabled {
        opacity: 0.7;
        cursor: not-allowed;
    }

    .message {
        font-size: 0.9rem;
        min-height: 1.2em;
    }

    .message.success {
        color: green;
    }

    .message.error {
        color: red;
    }

    @media (prefers-color-scheme: dark) {
        .newsletter-form {
            background: rgba(var(--white), 0.07);
        }

        .newsletter-form.article {
            background: linear-gradient(
                135deg,
                rgba(var(--accent-dark), 0.55) 0%,
                rgba(var(--accent-dark), 0.35) 100%
            );
            border-color: rgba(var(--accent-light), 0.4);
        }

        .content p {
            color: rgb(var(--black));
        }

        input[type="email"] {
            background: rgba(var(--white), 0.1);
            color: rgb(var(--black));
            border-color: rgba(var(--gray), 0.5);
        }

        input[type="email"]::placeholder {
            color: rgba(var(--black), 0.7);
        }
    }

    @media (max-width: 600px) {
        .input-group {
            flex-direction: column;
        }

        button {
            width: 100%;
        }
    }
</style>
