---
import KindBadge from "../KindBadge.astro";

interface Props {
	src?: string;
	alt: string;
	kind?: "articulo" | "short";
}

const { src, alt, kind } = Astro.props;
---

<div class="hero-image">
	{src && <img width={1020} height={510} src={src} alt={alt} />}
	{src && <KindBadge kind={kind} variant="overlay" />}
</div>

<style>
	.hero-image { position: relative; width: 100%; margin-top: 2rem; }
	.hero-image img { display: block; margin: 0 auto; width: 100%; height: auto; }
	:global(.post--short) .hero-image { margin-top: 1rem; }
	:global(.post--short) .hero-image img { max-width: 1020px; }
</style>
