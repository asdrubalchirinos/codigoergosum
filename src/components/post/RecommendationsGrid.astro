---
import { recomendaciones, listaUrl, esEnlaceReal } from "../../data/recomendaciones";

const rawBase = import.meta.env.BASE_URL;
const base = rawBase === "/" ? "" : rawBase.replace(/\/$/, "");
const libros = recomendaciones.filter((libro) => esEnlaceReal(libro.url));
const verLista = esEnlaceReal(listaUrl) ? listaUrl : null;
const rel = "sponsored nofollow noopener";

if (libros.length === 0) return null;
---

<aside class="card" aria-label="Mis recomendaciones" data-pagefind-ignore="all">
	<h3>Mis recomendaciones</h3>
	<div class="grid">
		{libros.map((libro) => (
			<a class="libro" href={libro.url} target="_blank" rel={rel}>
				<img src={`${base}${libro.image}`} alt={`Portada de ${libro.title}`} width="280" height="360" loading="lazy" />
				<strong>{libro.title}</strong>
				<span>{libro.note}</span>
			</a>
		))}
	</div>
	{verLista && <a class="boton" href={verLista} target="_blank" rel={rel}>Ver toda mi lista en Mercado Libre</a>}
	<p class="aviso">Enlaces de afiliado: si compras, recibo una pequeña comisión sin costo extra para ti.</p>
</aside>

<style>
	.card { margin-top: 2rem; padding: 1.25rem 1.5rem 1.4rem; border: 1px solid rgba(var(--gray), 0.3); border-radius: 8px; background: rgb(var(--white)); }
	.card h3 { margin-top: 0; margin-bottom: 1.1rem; font-size: 1.2rem; border-bottom: 2px solid rgb(var(--accent)); padding-bottom: 0.4rem; display: inline-block; }
	.grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.1rem; margin: 0 0 1.25rem; }
	.libro { text-decoration: none; color: inherit; display: block; }
	.libro img { display: block; width: 100%; aspect-ratio: 2 / 3; object-fit: cover; border-radius: 4px; box-shadow: 0 2px 6px rgba(var(--gray), 0.4); margin-bottom: 0.6rem; }
	.libro strong { display: block; font-size: 0.85rem; line-height: 1.3; color: rgb(var(--black)); }
	.libro span { display: block; font-size: 0.78rem; line-height: 1.35; color: rgb(var(--gray)); margin-top: 0.2rem; }
	.libro:hover strong { color: rgb(var(--accent)); }
	.boton { display: inline-flex; align-items: center; justify-content: center; min-height: 42px; padding: 0 1rem; border-radius: 6px; background: #000; color: #fff; font-weight: 700; text-decoration: none; transition: transform 0.2s, background 0.2s; }
	.boton:hover { transform: translateY(-2px); background: rgb(var(--accent-dark)); color: #fff; }
	.aviso { margin: 0.85rem 0 0; font-size: 0.8rem; line-height: 1.45; color: rgb(var(--gray)); }
	@media (max-width: 600px) { .grid { grid-template-columns: repeat(2, 1fr); gap: 1rem; } .card { padding: 1.1rem 1.1rem 1.25rem; } }
	@media (prefers-color-scheme: dark) { .card h3 { color: rgb(var(--black)); } }
</style>
