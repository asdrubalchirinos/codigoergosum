---
import { type CollectionEntry, getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import AIDisclaimer from "../../components/AIDisclaimer.astro";
import PostHero from "../../components/post/PostHero.astro";
import PostHeader from "../../components/post/PostHeader.astro";
import PostFooter from "../../components/post/PostFooter.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) =>
    import.meta.env.PROD ? data.draft !== true && data.pubDate <= new Date() : true,
  );
  return posts.map((post) => ({ params: { slug: post.slug }, props: post }));
}

const post = Astro.props as CollectionEntry<"blog">;
const { Content } = await post.render();
const rawBase = import.meta.env.BASE_URL;
const base = rawBase === "/" ? "" : rawBase.replace(/\/$/, "");
const isShort = post.data.kind === "short";
const language = post.data.lang || "es";
const heroSrc = post.data.heroImage ? `${base}${post.data.heroImage}` : undefined;
const shareUrl = new URL(Astro.url.pathname, Astro.site).toString();

let description = post.data.subtitle || "";
if (!description && post.body) {
  const cleaned = post.body
    .replace(/```[\s\S]*?```/g, "")
    .replace(/[#>*`]/g, "")
    .replace(/\[(.*?)\]\((.*?)\)/g, "$1")
    .replace(/!\[(.*?)\]\((.*?)\)/g, "")
    .replace(/\n+/g, " ")
    .trim();
  description = cleaned.slice(0, 240).trim();
  if (cleaned.length > 240) description += "…";
}

const wordCount = post.body
  ? post.body
      .replace(/```[\s\S]*?```/g, " ")
      .replace(/<[^>]+>|[#>*`_|[\]()!]/g, " ")
      .split(/\s+/)
      .filter(Boolean).length
  : undefined;
---

<BaseLayout
  title={post.data.title}
  description={description}
  image={post.data.heroImage}
  author={post.data.author}
  isArticle={true}
  imageAlt={post.data.title}
  publishDate={post.data.pubDate}
  modifiedDate={post.data.updatedDate}
  tags={post.data.tags}
  lang={language}
  wordCount={wordCount}
  kind={post.data.kind}
>
  <div class:list={["post", isShort && "post--short"]}>
    <article class:list={[isShort && "article--short"]} data-pagefind-body>
      <PostHero src={heroSrc} alt={post.data.title} kind={post.data.kind} />
      <div class="prose">
        <PostHeader
          title={post.data.title}
          subtitle={post.data.subtitle}
          author={post.data.author}
          pubDate={post.data.pubDate}
          updatedDate={post.data.updatedDate}
          lang={language}
          currentSlug={post.slug}
          translationOf={post.data.translationOf}
          kind={post.data.kind}
          hasHeroImage={Boolean(post.data.heroImage)}
        />
        <Content />
        <AIDisclaimer lang={language} />
      </div>
    </article>
    <PostFooter url={shareUrl} title={post.data.title} tags={post.data.tags} />
  </div>
</BaseLayout>

<style>
  .prose {
    max-width: 720px;
    width: 100%;
    margin: auto;
    padding: 1em;
    color: rgb(var(--gray-dark));
  }

  @media (prefers-color-scheme: dark) {
    .prose { color: rgb(var(--black)); }
  }

  .post--short :global(.ai-disclaimer) { margin-top: 1.5rem; }
</style>
