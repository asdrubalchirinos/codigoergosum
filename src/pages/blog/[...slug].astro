---
import { type CollectionEntry, getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import TranslationLink from "../../components/TranslationLink.astro";
import AIDisclaimer from "../../components/AIDisclaimer.astro";
import KindBadge from "../../components/KindBadge.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => {
    return import.meta.env.PROD
      ? data.draft !== true && data.pubDate <= new Date()
      : true;
  });
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: post,
  }));
}

const post = Astro.props as CollectionEntry<"blog">;
const { Content } = await post.render();
const rawBase = import.meta.env.BASE_URL;
const base = rawBase === "/" ? "" : rawBase.replace(/\/$/, "");
const isShort = post.data.kind === "short";

const shareUrl = new URL(Astro.url.pathname, Astro.site);
const shareText = `Lee "${post.data.title}" en Código Ergo Sum`;
const discussionText = `Leí "${post.data.title}" de @achirinos y mi punto de vista es:`;
const encodedShareText = encodeURIComponent(shareText);
const encodedDiscussionText = encodeURIComponent(discussionText);
const encodedShareUrl = encodeURIComponent(shareUrl.toString());

// Excerpt / description fallback
let excerptSource = post.data.subtitle || "";
if (!excerptSource) {
  const raw = (post.body as string | undefined) || "";
  if (raw) {
    const cleaned = raw
      .replace(/```[\s\S]*?```/g, "")
      .replace(/[#>*`]/g, "")
      .replace(/\[(.*?)\]\((.*?)\)/g, "$1")
      .replace(/!\[(.*?)\]\((.*?)\)/g, "")
      .replace(/\n+/g, " ")
      .trim();
    excerptSource = cleaned.slice(0, 240).trim();
    if (cleaned.length > 240) excerptSource += "…";
  }
}
const description = excerptSource;

const publishDate = post.data.pubDate;
const modifiedDate = post.data.updatedDate;

// Conteo aproximado de palabras (sin bloques de código ni marcado) para JSON-LD.
const wordCount = post.body
  ? post.body
      .replace(/```[\s\S]*?```/g, " ")
      .replace(/<[^>]+>|[#>*`_|[\]()!]/g, " ")
      .split(/\s+/)
      .filter(Boolean).length
  : undefined;

// Fecha en formato ISO (YYYY-MM-DD) a partir de los componentes locales,
// para que <time datetime> coincida con la fecha visible en cualquier zona horaria.
function isoDateOnly(date: Date): string {
  const year = date.getFullYear();
  const month = String(date.getMonth() + 1).padStart(2, "0");
  const day = String(date.getDate()).padStart(2, "0");
  return `${year}-${month}-${day}`;
}
---

<BaseLayout
  title={post.data.title}
  description={description}
  image={post.data.heroImage}
  author={post.data.author}
  isArticle={true}
  imageAlt={post.data.title}
  publishDate={publishDate}
  modifiedDate={modifiedDate}
  tags={post.data.tags}
  lang={post.data.lang || "es"}
  wordCount={wordCount}
  kind={post.data.kind}
>
  <div class:list={["post", isShort && "post--short"]}>
  <article class:list={[isShort && "article--short"]} data-pagefind-body>
    <div class="hero-image">
      {
        post.data.heroImage && (
          <img
            width={1020}
            height={510}
            src={`${base}${post.data.heroImage}`}
            alt={post.data.title}
          />
        )
      }
      {
        post.data.heroImage && (
          <KindBadge kind={post.data.kind} variant="overlay" />
        )
      }
    </div>
    <div class="prose">
      <div class="title">
        <div class="date">
          {
            !post.data.heroImage && (
              <KindBadge kind={post.data.kind} variant="inline" />
            )
          }
          {
            post.data.lang === "en" && (
              <span class="lang-indicator">🌐 English</span>
            )
          }
          <time datetime={isoDateOnly(post.data.pubDate)}>
            {
              post.data.pubDate.toLocaleDateString(
                post.data.lang === "en" ? "en-US" : "es-ES",
                {
                  year: "numeric",
                  month: "long",
                  day: "numeric",
                },
              )
            }
          </time>
          {
            post.data.updatedDate && (
              <span class="last-updated-on">
                {" · Actualizado "}
                <time datetime={isoDateOnly(post.data.updatedDate)}>
                  {post.data.updatedDate.toLocaleDateString(
                    post.data.lang === "en" ? "en-US" : "es-ES",
                    {
                      year: "numeric",
                      month: "long",
                      day: "numeric",
                    },
                  )}
                </time>
              </span>
            )
          }
        </div>
        <h1>{post.data.title}</h1>
        {post.data.subtitle && <p class="subtitle">{post.data.subtitle}</p>}
        <div class="meta">
          {
            post.data.author && (
              <span class="author">
                {post.data.lang === "en" ? "By" : "Por"} {post.data.author}
              </span>
            )
          }
        </div>
        <TranslationLink
          currentSlug={post.slug}
          currentLang={post.data.lang || "es"}
          translationOf={post.data.translationOf}
        />
        <hr />
      </div>
      <Content />

      <AIDisclaimer lang={post.data.lang || "es"} />
    </div>
  </article>

  <!-- CTA, compartir y tags fuera de <article>: los extractores los descartan -->
  <footer class="prose post-footer" data-pagefind-ignore="all">
      <div class="discussion-section">
        <p>¿Qué opinas sobre este post?</p>
        <a
          href={`https://x.com/intent/tweet?text=${encodedDiscussionText}&url=${encodedShareUrl}`}
          target="_blank"
          rel="noopener noreferrer"
          class="discussion-button"
        >
          Comentar en X
        </a>
      </div>

      <div class="article-links">
        <p class="share-label">Compartir:</p>
        <button
          data-url={`https://x.com/intent/tweet?text=${encodedShareText}&url=${encodedShareUrl}`}
          class="icon-link lnk-x"
          aria-label="Compartir en X (Twitter)"
        >
          <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"
            ><path
              d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
            ></path></svg
          >
        </button>
        <button
          data-url={`https://www.linkedin.com/sharing/share-offsite/?url=${encodedShareUrl}`}
          class="icon-link lnk-i"
          aria-label="Compartir en LinkedIn"
        >
          <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"
            ><path
              d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
            ></path></svg
          >
        </button>
        <button
          data-url={`https://www.facebook.com/sharer/sharer.php?u=${encodedShareUrl}`}
          class="icon-link lnk-f"
          aria-label="Compartir en Facebook"
        >
          <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"
            ><path
              d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"
            ></path></svg
          >
        </button>
        <button
          data-url={`https://wa.me/?text=${encodedShareText}%20${encodedShareUrl}`}
          class="icon-link lnk-w"
          aria-label="Compartir en WhatsApp"
        >
          <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"
            ><path
              d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"
            ></path></svg
          >
        </button>
        <button
          data-url={`https://www.threads.com/intent/post?text=${encodedShareText}&url=${encodedShareUrl}`}
          class="icon-link lnk-t"
          aria-label="Compartir en Threads"
        >
          <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"
            ><path
              d="M12.186 24h-.007c-3.581-.024-6.334-1.205-8.184-3.509C2.35 18.44 1.5 15.586 1.472 12.01v-.017c.03-3.579.879-6.43 2.525-8.482C5.845 1.205 8.6.024 12.18 0h.014c2.746.02 5.043.725 6.826 2.098 1.677 1.29 2.858 3.13 3.509 5.467l-2.04.569c-1.104-3.96-3.898-5.984-8.304-6.015-2.91.022-5.11.936-6.54 2.717C4.307 6.504 3.616 8.914 3.589 12c.027 3.086.718 5.496 2.057 7.164 1.43 1.783 3.631 2.698 6.54 2.717 2.623-.02 4.358-.631 5.8-2.045 1.647-1.613 1.618-3.593 1.09-4.798-.31-.71-.873-1.3-1.634-1.75-.192 1.352-.622 2.446-1.284 3.272-.886 1.102-2.14 1.704-3.73 1.79-1.202.065-2.361-.218-3.259-.801-1.063-.689-1.685-1.74-1.752-2.964-.065-1.19.408-2.285 1.33-3.082.88-.76 2.119-1.207 3.583-1.291a13.853 13.853 0 0 1 3.02.142c-.126-.742-.375-1.332-.75-1.757-.513-.586-1.308-.883-2.359-.89h-.029c-.844 0-1.992.232-2.721 1.32L7.734 7.847c.98-1.454 2.568-2.256 4.478-2.256h.044c3.194.02 5.097 1.975 5.287 5.388.108.046.216.094.321.142 1.49.7 2.58 1.761 3.154 3.07.797 1.82.871 4.79-1.548 7.158-1.85 1.81-4.094 2.628-7.277 2.65Zm1.003-11.69c-.242 0-.487.007-.739.021-1.836.103-2.98.946-2.916 2.143.067 1.256 1.452 1.839 2.784 1.767 1.224-.065 2.818-.543 3.086-3.71a10.5 10.5 0 0 0-2.215-.221z"
            ></path></svg
          >
        </button>
      </div>

      <script>
        document.querySelectorAll(".icon-link").forEach((btn) => {
          btn.addEventListener("click", () => {
            const url = (btn as HTMLElement).dataset.url;
            if (url) window.open(url, "_blank");
          });
        });
      </script>

      <div class="support-section">
        <p>
          ¿Te gustó este artículo? Apoya este blog y ayuda a que siga creciendo.
        </p>
        <a
          href="https://buymeacoffee.com/achirinos"
          target="_blank"
          rel="noopener noreferrer"
          class="coffee-button"
        >
          <span class="coffee-icon">☕</span>
          Invítame un café
        </a>
      </div>

      <div class="tags">
        {
          post.data.tags.map((tag) => (
            <a href={`/tags/${tag}`} class="tag">
              #{tag}
            </a>
          ))
        }
      </div>
  </footer>
  </div>
</BaseLayout>

<style>
  .hero-image {
    position: relative;
    width: 100%;
    margin-top: 2rem;
  }
  .hero-image img {
    display: block;
    margin: 0 auto;
    width: 100%;
    height: auto;
  }
  .prose {
    max-width: 720px;
    width: 100%;
    margin: auto;
    padding: 1em 1em 2em 1em;
    color: rgb(var(--gray-dark));
  }
  .post-footer {
    padding-top: 0;
  }
  .title {
    margin-bottom: 1em;
    padding: 1em 0;
    text-align: center;
    line-height: 1;
  }
  .title h1 {
    margin: 0 0 0.5em 0;
  }
  .subtitle {
    font-size: 1.5em;
    color: rgb(var(--gray));
    font-weight: normal;
    margin: 0.5em 0;
  }
  .date {
    margin-bottom: 0.5em;
    color: rgb(var(--gray));
  }
  .lang-indicator {
    display: inline-block;
    margin-right: 0.5em;
    padding: 0.15em 0.5em;
    background-color: #10b981;
    color: white;
    border-radius: 4px;
    font-size: 0.85em;
    font-weight: 600;
  }
  .last-updated-on {
    font-style: italic;
  }
  .discussion-section {
    margin-top: 4rem;
    padding: 1.5rem;
    border: 1px solid rgba(var(--accent), 0.35);
    border-radius: 8px;
    background: rgba(var(--accent-light), 0.22);
    text-align: center;
  }
  .discussion-section p {
    margin: 0 0 1rem 0;
    font-size: 1.1rem;
    font-weight: 600;
    color: rgb(var(--gray-dark));
  }
  .discussion-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 42px;
    padding: 0 1rem;
    border-radius: 6px;
    background: #000;
    color: #fff;
    font-weight: 700;
    text-decoration: none;
    transition:
      transform 0.2s,
      background 0.2s;
  }
  .discussion-button:hover {
    transform: translateY(-2px);
    background: rgb(var(--accent-dark));
  }
  .article-links {
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid rgb(var(--gray-light));
    display: flex;
    gap: 1rem;
    align-items: center;
  }
  .article-links .share-label {
    margin: 0;
    font-size: 1rem;
    font-weight: 700;
    margin-right: 0.5rem;
  }
  .icon-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    color: white;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
    transition: transform 0.2s;
  }
  .icon-link:hover {
    transform: translateY(-2px);
  }
  .icon-link.lnk-x {
    background-color: #000;
  }
  .icon-link.lnk-i {
    background-color: #0077b5;
  }
  .icon-link.lnk-f {
    background-color: #1877f2;
  }
  .icon-link.lnk-w {
    background-color: #25d366;
  }
  .icon-link.lnk-t {
    background-color: #101010;
  }
  .tags {
    margin-top: 2rem;
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap; /* avoid horizontal overflow on many tags */
  }
  .tag {
    background: rgba(var(--gray-light), 0.6);
    padding: 0.25rem 0.65rem;
    border-radius: 6px;
    font-size: 0.85rem;
    line-height: 1.2;
    text-decoration: none;
    color: rgb(var(--gray-dark));
    border: 1px solid rgba(var(--gray), 0.25);
    transition:
      background 0.2s,
      color 0.2s;
  }
  .tag:hover {
    background: rgb(var(--accent));
    color: #fff;
  }
  .support-section {
    margin-top: 3rem;
    padding: 2rem 1.5rem;
    background: linear-gradient(
      135deg,
      rgba(var(--accent-light), 0.35) 0%,
      rgba(var(--accent-light), 0.15) 100%
    );
    border-radius: 16px;
    text-align: center;
    border: 1px solid rgba(var(--accent), 0.5);
    box-shadow: 0 4px 14px -2px rgba(var(--gray), 0.25);
  }
  .support-section p {
    margin: 0 0 1.5rem 0;
    font-size: 1.1rem;
    color: rgb(var(--gray-dark));
  }
  .coffee-button {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgb(var(--accent));
    color: #fff;
    padding: 0.75rem 1.5rem;
    border-radius: 10px;
    text-decoration: none;
    font-weight: 600;
    letter-spacing: 0.5px;
    transition:
      background 0.25s,
      transform 0.25s,
      box-shadow 0.25s;
    box-shadow: 0 4px 8px -2px rgba(var(--accent), 0.5);
  }
  .coffee-button:hover {
    background: rgb(var(--accent-dark));
    transform: translateY(-3px);
    box-shadow: 0 6px 14px -2px rgba(var(--accent), 0.55);
  }
  .coffee-icon {
    font-size: 1.5rem;
  }

  @media (prefers-color-scheme: dark) {
    .prose {
      color: rgb(var(--black));
    }
    .support-section {
      background: linear-gradient(
        135deg,
        rgba(var(--accent-dark), 0.55) 0%,
        rgba(var(--accent-dark), 0.35) 100%
      );
      border-color: rgba(var(--accent-light), 0.4);
    }
    .support-section p {
      color: rgb(var(--black));
    }
    .discussion-section {
      background: rgba(var(--accent-dark), 0.28);
      border-color: rgba(var(--accent-light), 0.35);
    }
    .discussion-section p {
      color: rgb(var(--black));
    }
    .tag {
      background: rgba(var(--gray-light), 0.35);
      color: rgb(var(--black));
      border-color: rgba(var(--gray), 0.3);
    }
    .tag:hover {
      background: rgb(var(--accent));
      color: #fff;
    }
  }

  .post--short .hero-image {
    margin-top: 1rem;
  }
  .post--short .hero-image img {
    max-height: 280px;
    object-fit: cover;
  }
  .post--short .title {
    padding: 0.5em 0;
    margin-bottom: 0.5em;
  }
  .post--short .title h1 {
    font-size: 2rem;
  }
  .post--short .subtitle {
    font-size: 1.2em;
  }
  .post--short .date {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .post--short .discussion-section {
    margin-top: 2rem;
  }
  .post--short .article-links {
    margin-top: 2rem;
    padding-top: 1.25rem;
  }
  .post--short .support-section {
    margin-top: 1.5rem;
    padding: 1.5rem 1.25rem;
  }
  .post--short :global(.ai-disclaimer) {
    margin-top: 1.5rem;
  }
</style>
