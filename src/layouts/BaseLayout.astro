---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import WebMCP from "../components/WebMCP.astro";

interface Props {
  title: string;
  description: string;
  image?: string;
  author?: string;
  isArticle?: boolean;
  imageAlt?: string;
  publishDate?: Date | string;
  modifiedDate?: Date | string;
  tags?: string[];
  imageWidth?: number;
  imageHeight?: number;
  lang?: "es" | "en";
  wordCount?: number;
  kind?: "articulo" | "short";
}

const {
  title,
  description,
  image,
  author,
  isArticle = false,
  imageAlt,
  publishDate,
  modifiedDate,
  tags = [],
  imageWidth,
  imageHeight,
  lang = "es",
  wordCount,
  kind,
} = Astro.props as Props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <BaseHead
      title={title}
      description={description}
      image={image}
      author={author}
      isArticle={isArticle}
      imageAlt={imageAlt}
      publishDate={publishDate}
      modifiedDate={modifiedDate}
      tags={tags}
      imageWidth={imageWidth}
      imageHeight={imageHeight}
      lang={lang}
      wordCount={wordCount}
      kind={kind}
    />
    <script
      is:inline
      data-goatcounter="https://codigoergosum.goatcounter.com/count"
      async
      src="//gc.zgo.at/count.js"></script>
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <WebMCP />
  </body>
</html>
